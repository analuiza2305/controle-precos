rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // "papeis/{email}" define quem pode editar. Sem documento = somente visualização.
    // Gerenciado manualmente no console do Firestore (ver README).
    function papelDoUsuario() {
      return get(/databases/$(database)/documents/papeis/$(request.auth.token.email)).data.papel;
    }

    function temPapel(valor) {
      return autenticado() &&
        exists(/databases/$(database)/documents/papeis/$(request.auth.token.email)) &&
        papelDoUsuario() == valor;
    }

    function ehEditor() {
      return temPapel("editor");
    }

    // Operacional: só pode lançar/editar/excluir puxadas (não mexe em
    // fornecedores, produtos, preço do dia/cotações).
    function ehOperacional() {
      return temPapel("operacional");
    }

    match /papeis/{email} {
      // cada pessoa só consegue ler o próprio papel; edição é feita manualmente no console
      allow read: if autenticado() && request.auth.token.email == email;
      allow write: if false;
    }

    match /fornecedores/{id} {
      allow read: if autenticado();
      allow write: if ehEditor();
    }

    match /produtos/{id} {
      allow read: if autenticado();
      allow write: if ehEditor();
    }

    match /cotacoes/{id} {
      allow read: if autenticado();
      allow write: if ehEditor();
    }

    match /puxadas/{id} {
      allow read: if autenticado();
      allow write: if ehEditor() || ehOperacional();
    }

    // Anotações do dia: qualquer pessoa autenticada pode registrar observações,
    // independente do papel (editor ou somente visualização).
    match /notas/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }
  }
}
